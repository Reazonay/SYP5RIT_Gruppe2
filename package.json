{
  "name": "restaurant-reservations",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test:db": "bash scripts/test-db.sh",
    "test:browser": "bash scripts/test-browser.sh",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,css,json,html}' package.json playwright.config.ts tests/restaurant.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=24"
  }
}
